# Copy to .env for local development. Never commit real credentials.
RAG_DASHSCOPE_API_KEY=
RAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=512
RAG_PRIMARY_LLM_MODEL=qwen3.8-flash
RAG_BACKUP_LLM_MODEL=qwen3.7-flash
RAG_LLM_TIMEOUT_SECONDS=30
RAG_DATA_DIR=data/runtime
RAG_UPLOAD_MAX_BYTES=10485760
RAG_CHUNK_MIN_TOKENS=256
RAG_CHUNK_MAX_TOKENS=768
RAG_CHUNK_OVERLAP_RATIO=0.15
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_K=20

