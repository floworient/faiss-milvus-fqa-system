      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_evaluate_retrieval_api_v1_evaluations_retrieval_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Mode",
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "dataset_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Name"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_evaluate_retrieval_api_v1_evaluations_retrieval_post"
      },
      "Body_upload_document_api_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_v1_documents_post"
      },
      "ChatCompletionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy",
            "default": "contextual_rag"
          },
          "retrieval_mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Retrieval Mode",
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "candidate_k": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Candidate K",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatCompletionRequest"
      },
      "ChatCompletionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "provider_tier": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Provider Tier"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationResponse"
            },
            "type": "array",
            "title": "Citations"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalTraceResponse"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "answer",
          "provider_tier",
          "citations",
          "retrieval",
          "metadata"
        ],
        "title": "ChatCompletionResponse"
      },
      "CitationResponse": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "source_name"
        ],
        "title": "CitationResponse"
      },
      "DocumentResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "deleted"
            ],
            "title": "Status"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "source_name",
          "status",
          "chunk_count"
        ],
        "title": "DocumentResponse"
      },
      "EvaluationReportResponse": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Mode"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K"
          },
          "query_count": {
            "type": "integer",
            "title": "Query Count"
          },
          "hit_at_1": {
            "type": "number",
            "title": "Hit At 1"
          },
          "recall_at_k": {
            "type": "number",
            "title": "Recall At K"
          },
          "mrr": {
            "type": "number",
            "title": "Mrr"
          },
          "answer_accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Accuracy"
          },
          "configuration": {
            "additionalProperties": true,
            "type": "object",
            "title": "Configuration"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/QueryEvaluationResponse"
            },
            "type": "array",
            "title": "Queries"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "top_k",
          "query_count",
          "hit_at_1",
          "recall_at_k",
          "mrr",
          "answer_accuracy",
          "configuration",
          "queries"
        ],
        "title": "EvaluationReportResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageResponse": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "failed"
            ],
            "title": "Status"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationResponse"
            },
            "type": "array",
            "title": "Citations"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content",
          "status",
          "citations",
          "metadata"
        ],
        "title": "MessageResponse"
      },
      "QueryEvaluationResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "first_relevant_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Relevant Rank"
          },
          "recall_at_k": {
            "type": "number",
            "title": "Recall At K"
          },
          "returned_chunk_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Returned Chunk Ids"
          },
          "returned_document_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Returned Document Ids"
          }
        },
        "type": "object",
        "required": [
          "query",
          "first_relevant_rank",
          "recall_at_k",
          "returned_chunk_ids",
          "returned_document_ids"
        ],
        "title": "QueryEvaluationResponse"
      },
      "RetrievalItemResponse": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "vector_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vector Rank"
          },
          "keyword_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keyword Rank"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "text",
          "source",
          "position",
          "score",
          "rank",
          "vector_rank",
          "keyword_rank"
        ],
        "title": "RetrievalItemResponse"
      },
      "RetrievalSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Mode",
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "candidate_k": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Candidate K",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrievalSearchRequest"
      },
      "RetrievalSearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Mode"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievalItemResponse"
            },
            "type": "array",
            "title": "Results"
          },
          "degraded_from": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "vector",
                  "keyword",
                  "hybrid"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded From"
          },
          "degradation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degradation Reason"
          }
        },
        "type": "object",
        "required": [
          "query",
          "mode",
          "results"
        ],
        "title": "RetrievalSearchResponse"
      },
      "RetrievalTraceResponse": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "vector",
              "keyword",
              "hybrid"
            ],
            "title": "Mode"
          },
          "degraded_from": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "vector",
                  "keyword",
                  "hybrid"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded From"
          },
          "degradation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degradation Reason"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "RetrievalTraceResponse"
      },
      "SessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "type": "array",
            "title": "Messages"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "messages",
          "metadata"
        ],
        "title": "SessionResponse"
      },
      "TaskResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "upload",
              "delete"
            ],
            "title": "Action"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed"
            ],
            "title": "Status"
          },
          "code": {
