{
  "info": {
    "name": "RAG Knowledge QA API",
    "description": "面向 Apifox 的完整调试集合。先导入 local 环境并按 README 执行。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const suffix = Date.now() + '_' + Math.random().toString(16).slice(2);",
          "pm.environment.set('request_id', 'req_apifox_' + suffix);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "00 系统",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('服务状态正常', function () { pm.expect(body.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 文档与任务",
      "item": [
        {
          "name": "上传知识文档",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/knowledge.md",
                  "description": "导入后如客户端未解析相对路径，请重新选择同目录文件。"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('返回上传任务', function () {",
                  "  pm.expect(body.action).to.eql('upload');",
                  "  pm.expect(body.task_id).to.match(/^task_[0-9a-f]{32}$/);",
                  "  pm.expect(body.document_id).to.match(/^doc_[0-9a-f]{32}$/);",
                  "});",
                  "if (pm.response.code === 202 && body.task_id && body.document_id) {",
                  "  pm.environment.set('upload_task_id', body.task_id);",
                  "  pm.environment.set('task_id', body.task_id);",
                  "  pm.environment.set('document_id', body.document_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "查询上传任务（成功前可重复执行）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tasks/{{upload_task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{upload_task_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('上传任务状态合法', function () {",
                  "  pm.expect(['pending', 'running', 'succeeded', 'failed']).to.include(body.status);",
                  "});",
                  "pm.test('上传任务未失败', function () {",
                  "  pm.expect(body.status).not.eql('failed');",
                  "});",
                  "if (body.status === 'failed') {",
                  "  pm.environment.unset('document_id');",
                  "  console.error('上传任务失败', body.code, body.message);",
                  "}",
                  "if (body.status === 'succeeded') {",
                  "  pm.environment.set('document_id', body.document_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "查询文档列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('文档列表为数组', function () { pm.expect(body).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "删除知识文档",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "{{document_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('返回删除任务', function () { pm.expect(body.action).to.eql('delete'); });",
                  "if (pm.response.code === 202 && body.task_id) {",
                  "  pm.environment.set('delete_task_id', body.task_id);",
                  "  pm.environment.set('task_id', body.task_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "查询删除任务（成功前可重复执行）",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tasks/{{delete_task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{delete_task_id}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('返回 X-Request-ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('删除任务状态合法', function () {",
                  "  pm.expect(['pending', 'running', 'succeeded', 'failed']).to.include(body.status);",
                  "});",
                  "pm.test('删除任务未失败', function () {",
                  "  pm.expect(body.status).not.eql('failed');",
                  "});",
                  "if (body.status === 'failed') {",
                  "  console.error('删除任务失败', body.code, body.message);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
